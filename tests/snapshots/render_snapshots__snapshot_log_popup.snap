"┌Magi───────────────────────────────────────────────────────────────/repo/magi/┐"
"┌Log───────────────────────────────────────────────────────────────────────────┐"
"│Commit limiting                                                               │"
"│ -n Limit number of commits (-n256)                                           │"
"│ -A Limit to author (--author=)                                               │"
"│ -F Search messages (--grep=)                                                 │"
"│                                                                              │"
"│Formatting                                                                    │"
"│ -g Show graph (--graph)                                                      │"
"│ -c Show graph in color (--color)                                             │"
"│ -d Show refnames (--decorate)                                                │"
"│ =S Show signatures (--show-signature)                                        │"
"│ -h Show header (++header)                                                    │"
"│ -p Show diffs (--patch)                                                      │"
"│ -s Show diffstats (--stat)                                                   │"
"│                                                                              │"
"│Log                Reflog                                                     │"
"│ l Current          r Current                                                 │"
"│ o Other            O Other                                                   │"
"│ u Related          H HEAD                                                    │"
